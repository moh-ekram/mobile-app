<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Bar: Course Name (small), Tag Badge & Next Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Course Name (Small font at top) -->
        <TextView
            android:id="@+id/widget_course_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GRE VOCABULARY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Tag Badge -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KNOW"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" />

        <!-- Next Button -->
        <TextView
            android:id="@+id/widget_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next ➔"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4F46E5"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Place 1: Word (Text color corresponds to Tag color) -->
    <TextView
        android:id="@+id/widget_word_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ephemeral"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#059669"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Place 2: Meaning -->
    <TextView
        android:id="@+id/widget_word_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Lasting for a very short time; fleeting or transient."
        android:textSize="12sp"
        android:textColor="#334155"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Extra: Example or note -->
    <TextView
        android:id="@+id/widget_word_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Tap to open in Memorizer"
        android:textSize="10sp"
        android:textStyle="italic"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
