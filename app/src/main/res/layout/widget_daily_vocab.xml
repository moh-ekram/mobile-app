<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Top Bar: Course Name (small), Tag Badge & Next Button -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Course Name (Small font at top) -->
        <TextView
            android:id="@+id/widget_course_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VOCABULARY"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Status Tag Badge (Hidden per user request) -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Previous Button -->
        <TextView
            android:id="@+id/widget_prev_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#6366F1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:includeFontPadding="false" />

        <!-- Next Button -->
        <TextView
            android:id="@+id/widget_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next ▶"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#4F46E5"
            android:paddingLeft="4dp"
            android:paddingRight="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Center Content Area: Weight=1 with vertical center gravity eliminates empty whitespace -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="1dp">

        <!-- Place 1: Word -->
        <TextView
            android:id="@+id/widget_word_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ephemeral"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Place 2: Meaning (Inside ViewFlipper with fade_in transition animation) -->
        <ViewFlipper
            android:id="@+id/widget_meaning_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inAnimation="@android:anim/fade_in">

            <!-- Child 0: Guessing / Waiting Placeholder -->
            <TextView
                android:id="@+id/widget_meaning_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🤔 Tap to reveal meaning..."
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="#94A3B8"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- Child 1: The Meaning (Place 2) -->
            <TextView
                android:id="@+id/widget_word_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lasting for a very short time; fleeting or transient."
                android:textSize="11.5sp"
                android:textColor="#334155"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:includeFontPadding="false" />
        </ViewFlipper>

        <!-- Extra: Example or note -->
        <TextView
            android:id="@+id/widget_word_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="10sp"
            android:textStyle="italic"
            android:textColor="#64748B"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
